PORT=5000
MONGO_URI=your_mongodb_connection_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Optional (defaults shown)
# SERVER_URL=http://localhost:5000
# UPLOAD_DIR=uploads
# REDIS_URL=redis://127.0.0.1:6379
# ELASTICSEARCH_URL=http://127.0.0.1:9200
# Razorpay test mode (payments are disabled when these are empty)
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret
# RAZORPAY_WEBHOOK_SECRET=any_long_random_string
# Image storage: local (default), cloudinary or s3
# STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# S3_BUCKET=your_bucket_name
# S3_REGION=your_bucket_region
# S3_PUBLIC_URL=https://your-bucket-or-cdn-domain (optional)
# S3 credentials are read from the standard AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY variables

# Deployment (production values are set in the Render dashboard, never committed)
# NODE_ENV=production
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/shopsphere
# CLIENT_URL=https://your-app.vercel.app
# SERVER_URL=https://your-api.onrender.com
# REDIS_URL=rediss://default:password@your-host:6379
# ELASTICSEARCH_URL=https://your-deployment.es.region.cloud.es.io
# STORAGE_DRIVER=cloudinary
